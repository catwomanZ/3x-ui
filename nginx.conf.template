# Rendered by /opt/entrypoint.sh — placeholders are @@NAME@@.
#
# Why this file exists at all: Railway routes exactly one public port per
# service and terminates TLS at its own edge. The panel wants 2053, the
# subscription server wants 2096 and the Xray inbound wants its own port, so
# all three are put on loopback and split here by URL path.
#
# Important: 3x-ui serves the panel at "<webBasePath><webBasePath>..." — with a
# webBasePath of /panel/ the real API lives at /panel/panel/api/. The panel
# therefore needs the URI forwarded UNCHANGED. Do not add a trailing slash to
# proxy_pass for the panel location: that would strip the prefix and the SPA's
# absolute asset URLs (/panel/assets/...) would 404.

worker_processes 1;
error_log /dev/stderr warn;
pid /run/nginx/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Railway's edge terminates TLS and talks plain HTTP to us.
    access_log /dev/stdout;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;

    # WebSocket tunnels are long-lived; the default 60s read timeout drops them.
    # Xray sends no application-level keepalive, so this must cover idle time.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen @@HTTP_PORT@@;
        listen [::]:@@HTTP_PORT@@;
        server_name _;

        # Railway's own health probe + a cheap liveness endpoint.
        location = /healthz {
            access_log off;
            add_header Content-Type text/plain;
            return 200 "ok\n";
        }

        # --- Panel ------------------------------------------------------------
        # URI is passed through untouched on purpose (see the note above).
        location @@PANEL_PATH@@ {
            proxy_pass http://127.0.0.1:@@PANEL_PORT@@;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # --- Subscription -----------------------------------------------------
        # The sub server serves the panel's generated subPath on @@SUB_PORT@@.
        # A stable public path (/sub/) is exposed and rewritten onto it, so the
        # link you put in v2rayNG never changes when the panel rotates it.

        # /sub on its own serves a small viewer that decodes the base64 and
        # shows the links, because the raw endpoint is not human readable.
        location = @@SUB_PATH_NOSLASH@@ {
            default_type text/html;
            alias /opt/sub.html;
        }

        location @@SUB_PATH@@ {
            # Drop a trailing slash before proxying. The sub server is a Go
            # mux mounted at @@SUB_REAL_PATH@@; asked for <id>/ it answers 301
            # to @@SUB_REAL_PATH@@<id>, an absolute path outside /sub/, which
            # then falls into "location /" and 404s. Chrome appends that slash
            # on its own, so /sub/mobile/ has to work too.
            rewrite ^@@SUB_PATH@@$ @@SUB_PATH_NOSLASH@@ last;
            rewrite ^@@SUB_PATH@@(.+?)/+$ @@SUB_PATH@@$1 last;
            rewrite ^@@SUB_PATH@@(.*)$ @@SUB_REAL_PATH@@$1 break;
            proxy_pass http://127.0.0.1:@@SUB_PORT@@;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # --- VLESS + WebSocket inbound ---------------------------------------
        # Xray listens on loopback here; Railway's edge already did the TLS.
        location @@TUNNEL_PATH@@ {
            proxy_pass http://127.0.0.1:@@INBOUND_PORT@@;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            # Tunnel traffic is idle most of the time; do not reap it.
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_buffering off;
        }

        # Anything else is not ours to answer. Returning 404 (rather than
        # proxying to Xray) keeps scanners off the inbound.
        location / {
            return 404;
        }
    }
}
